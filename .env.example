# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String
# Local Development:
# MONGODB_URI=mongodb://localhost:27017/employee360
# Production / Cloud / Vercel (MongoDB Atlas):
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas details:
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/employee360?retryWrites=true&w=majority

# Redis Cache (Optional - Automatically falls back to in-memory cache if not provided)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_SECRET=super_secret_employee360_jwt_key_2026_dev_mode
JWT_EXPIRES_IN=7d

# URLs
# For local development:
CLIENT_URL=http://localhost:3000
VITE_API_URL=http://localhost:5000/api
# For Vercel production:
# Leave VITE_API_URL empty or unset on Vercel to automatically use relative '/api'
